    file, You can obtain one at https://mozilla.org/MPL/2.0/.
-->
<!--
    Shared control styles of the main window (both themes; colors come from Palette.axaml). Avalonia has no triggers; each WPF Style.Trigger became a selector with a
    pseudo-class (:pointerover, :pressed, :disabled, :checked, :selected) or a style class set from code or bindings
    (Classes.active="{Binding ...}"). The WPF keys map to classes:
        CmdBarButton      -> Button.cmd
        CloseCmdBarButton -> Button.cmd.close
        NavRow            -> Border.navRow  (plus .active for the current location)
        PinGlyph / ChevronGlyph -> ic:SymbolIcon.pin / .chevron
        ModernSlider      -> Slider.modern
    "hover" is a reusable class for any Border that only needs the hover background.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:ByteExplorer.Icons"
        xmlns:side="using:ByteExplorer.Views.Sidebar"
        xmlns:views="using:ByteExplorer.Views">

    <Styles.Resources>
        <!-- A collapsible sidebar section: the title (click to fold) with a chevron, buttons on the right, then the rows. -->
        <ControlTheme x:Key="{x:Type side:SidebarSection}" TargetType="side:SidebarSection">
            <!-- The parts the left panel designs switch on (SidebarDesigns below): a leading chevron and an icon (Guides,
                 Cards), the title in capitals (Quiet, Chips), the count while collapsed, a chevron at the right end, a card
                 behind the section, a guide line beside its rows. Classic shows only the title, its chevron and the buttons. -->
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Card" Background="Transparent">
                        <StackPanel>
                            <Grid Name="PART_Header" ColumnDefinitions="*,Auto,Auto,Auto" Margin="{TemplateBinding HeaderMargin}" MinHeight="24" Background="Transparent">
                                <ToggleButton Name="PART_Toggle" Classes="sectionToggle"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              ToolTip.Tip="Show or hide">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <ic:SymbolIcon Name="PART_LeadChevron" Symbol="ChevronDown" FontSize="9" Width="12" IsVisible="False"
                                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <ic:SymbolIcon Name="PART_Icon" Symbol="{TemplateBinding Icon}" FontSize="14" IsVisible="False"
                                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                        <TextBlock Name="PART_Title" Classes="sidebarHeader" Text="{TemplateBinding Header}"/>
                                        <TextBlock Name="PART_Caps" Classes="sidebarCaps" Text="{TemplateBinding HeaderCaps}" IsVisible="False"/>
                                        <ic:SymbolIcon Name="PART_Chevron" Symbol="ChevronDown" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock Name="PART_Count" Classes="sidebarCount" Text="{TemplateBinding CountText}" IsVisible="False"/>
                                        <Border Name="PART_Badge" Classes="sidebarBadge" IsVisible="False">
                                            <TextBlock Text="{TemplateBinding CountText}"/>
                                        </Border>
                                    </StackPanel>
                                </ToggleButton>
                                <TextBlock Name="PART_CountEnd" Grid.Column="1" Classes="sidebarCount" Text="{TemplateBinding CountText}" IsVisible="False" Margin="0,0,6,0"/>
                                <ContentPresenter Name="PART_Actions" Grid.Column="2" Content="{TemplateBinding HeaderActions}" VerticalAlignment="Center"/>
                                <ToggleButton Name="PART_TrailToggle" Grid.Column="3" Classes="sectionToggle" IsVisible="False" Focusable="False"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              ToolTip.Tip="Show or hide">
                                    <ic:SymbolIcon Name="PART_TrailChevron" Symbol="ChevronDown" FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                </ToggleButton>
                            </Grid>
                            <Panel Name="PART_Body" IsVisible="{TemplateBinding IsExpanded}">
                                <Border Name="PART_Guide" Width="1" HorizontalAlignment="Left" Margin="16,0,0,4" IsHitTestVisible="False" IsVisible="False"
                                        Background="{DynamicResource BorderLight}"/>
                                <ContentPresenter Name="PART_Content" Content="{TemplateBinding Content}"/>
                            </Panel>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:collapsed /template/ ic|SymbolIcon#PART_Chevron">
                <Setter Property="RenderTransform" Value="rotate(-90deg)"/>
            </Style>
            <Style Selector="^:collapsed /template/ ic|SymbolIcon#PART_LeadChevron">
                <Setter Property="RenderTransform" Value="rotate(-90deg)"/>
            </Style>
            <Style Selector="^:collapsed /template/ ic|SymbolIcon#PART_TrailChevron">
                <Setter Property="RenderTransform" Value="rotate(-90deg)"/>
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="ToggleButton.sectionToggle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="ToggleButton.sectionToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.sectionToggle:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.sectionToggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ToggleButton.sectionToggle:pointerover TextBlock.sidebarHeader">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <!-- ===== Command bar buttons ===== -->
    <Style Selector="Button.cmd">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bd" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <!-- Not named PART_ContentPresenter: Fluent's Button styles target that name and would paint their own
                         (light) disabled/pressed backgrounds over this flat command-bar look. -->
                    <ContentPresenter Name="cp" Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.cmd:pointerover /template/ Border#bd">
        <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
    </Style>
    <Style Selector="Button.cmd:pressed /template/ Border#bd">
        <Setter Property="Background" Value="{DynamicResource PressedBg}"/>
    </Style>
    <Style Selector="Button.cmd:disabled /template/ ContentPresenter#cp">
        <Setter Property="Opacity" Value="0.35"/>
    </Style>
    <Style Selector="Button.cmd.active /template/ Border#bd">
        <Setter Property="Background" Value="{DynamicResource SelectedBg}"/>
    </Style>
    <Style Selector="Button.cmd.close">
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.cmd.close:pointerover /template/ Border#bd">
        <Setter Property="Background" Value="{DynamicResource CloseHoverBg}"/>
    </Style>
    <Style Selector="Button.cmd.close:pointerover">
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Toggle buttons in the command bar (selectors) look like Button.cmd. -->
    <Style Selector="ToggleButton.cmd">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="ToggleButton.cmd:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="ToggleButton.cmd:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectedBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="ToggleButton.cmd:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PressedBg}"/>
    </Style>

    <!-- ===== Navigation rows (left pane) ===== -->
    <Style Selector="Border.navRow">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="6,0,6,0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.navRow:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
    </Style>
    <Style Selector="Border.navRow.active">
        <Setter Property="Background" Value="{DynamicResource NavSelectedBg}"/>
    </Style>
    <!-- Lens pills (left pane › Lens): two per row, so ten lenses take five short rows above the tree. -->
    <Style Selector="Border.lensPill">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="9,0,8,0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.lensPill:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
    </Style>
    <Style Selector="Border.lensPill.active">
        <Setter Property="Background" Value="{DynamicResource NavSelectedBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SelectedAccent}"/>
    </Style>
    <Style Selector="Border.lensPill.active ic|SymbolIcon">
        <Setter Property="Foreground" Value="{DynamicResource SelectedAccent}"/>
    </Style>
    <!-- A saved place that isn't reachable now (a bookmark on a disconnected drive). -->
    <Style Selector="Border.navRow.unavailable">
        <Setter Property="Opacity" Value="0.5"/>
    </Style>
    <!-- Sidebar section titles: "Quick access", "Network", "Recent". -->
    <Style Selector="TextBlock.sidebarHeader">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.navRow.dropTarget">
        <Setter Property="Background" Value="{DynamicResource SelectedBg}"/>
    </Style>
    <Style Selector="Border.hover">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.hover:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
    </Style>

    <Style Selector="ic|SymbolIcon.pin">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource PinGray}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Symbol" Value="Pin"/>
    </Style>
    <Style Selector="ic|SymbolIcon.chevron">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== Text boxes embedded in dark chrome (address bar, search, filter) ===== -->
    <Style Selector="TextBox.bare">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource SelectedAccent}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.bare /template/ Border#PART_BorderElement, TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement, TextBox.bare:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ===== Slider (ModernSlider) ===== -->
    <!-- The status bar's zoom slider: the Fluent template keeps a header row and room above and below the track (32 px in
         all), which pushed the track below the middle of a bar shorter than that. Without that room the slider is only as
         tall as its thumb, so VerticalAlignment="Center" puts the track on the bar's center line. -->
    <Style Selector="Slider.modern">
        <Style.Resources>
            <x:Double x:Key="SliderHorizontalHeight">0</x:Double>
            <GridLength x:Key="SliderPreContentMargin">0</GridLength>
            <GridLength x:Key="SliderPostContentMargin">0</GridLength>
        </Style.Resources>
        <Setter Property="Foreground" Value="{DynamicResource SelectedAccent}"/>
        <Setter Property="Background" Value="{DynamicResource BorderLight}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Slider.modern /template/ Thumb">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
    </Style>
    <Style Selector="TextBox.bare:disabled">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    </Style>

    <!-- ===== Split view: the active pane has an accent line along its top ===== -->
    <Style Selector="views|FileListView.splitPane">
        <Setter Property="BorderThickness" Value="0,2,0,0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="views|FileListView.splitPane.activePane">
        <Setter Property="BorderBrush" Value="{DynamicResource SelectedAccent}"/>
    </Style>

    <!-- ===== Grid splitters ===== -->
    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource NavBarBrush}"/>
        <Setter Property="MinWidth" Value="3"/>
    </Style>

    <!-- ===== Menus (the custom context menu and every flyout) ===== -->
    <Style Selector="ContextMenu, MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource MenuBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="MinWidth" Value="220"/>
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="MenuItem.danger">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <!-- ===== Panel menus (the Nemo tools menu): a flyout of flat rows, icon steppers and switches ===== -->
    <Style Selector="FlyoutPresenter.tools">
        <Setter Property="Background" Value="{DynamicResource MenuBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="MaxWidth" Value="320"/>
        <Setter Property="MaxHeight" Value="2000"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style Selector="Button.menuRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bd" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="cp" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.menuRow.sub">
        <Setter Property="Padding" Value="28,6,12,6"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style Selector="Button.menuRow:pointerover /template/ Border#bd">
        <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
    </Style>
    <Style Selector="Button.menuRow:pressed /template/ Border#bd, Button.menuRow.checked /template/ Border#bd">
        <Setter Property="Background" Value="{DynamicResource SelectedBg}"/>
    </Style>
    <Style Selector="Button.menuRow:disabled /template/ ContentPresenter#cp">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="Button.menuIcon">
        <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Name="cp" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.menuIcon.first">
        <Setter Property="CornerRadius" Value="6,0,0,6"/>
    </Style>
    <Style Selector="Button.menuIcon.middle">
        <Setter Property="BorderThickness" Value="0,1"/>
    </Style>
    <Style Selector="Button.menuIcon.last">
        <Setter Property="CornerRadius" Value="0,6,6,0"/>
    </Style>
    <Style Selector="Button.menuIcon:pointerover /template/ Border#bd">
        <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
    </Style>
    <Style Selector="Button.menuIcon:pressed /template/ Border#bd, Button.menuIcon.checked /template/ Border#bd">
        <Setter Property="Background" Value="{DynamicResource SelectedBg}"/>
    </Style>
    <Style Selector="Button.menuIcon:disabled /template/ ContentPresenter#cp">
        <Setter Property="Opacity" Value="0.35"/>
    </Style>
    <Style Selector="Border.menuDivider">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource BorderLight}"/>
        <Setter Property="Margin" Value="8,5"/>
    </Style>
    <Style Selector="Border.menuDivider.sub">
        <Setter Property="Margin" Value="28,4,12,4"/>
    </Style>
    <!-- A switch without its On/Off text. -->
    <Style Selector="ToggleSwitch.compact">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Tool tips in the dark palette. -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource MenuBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
    </Style>

    <!-- =====================================================================================================================
         Left panel designs (Settings > Left panel > Design; the Modern layout). A class on the panel picks one:
           (none)                 Classic: lines between sections, the title with its chevron.
           sbModern sbQuiet       Quiet labels: small capitals, no lines, the count while collapsed, chevron and + on hover.
           sbModern sbCards       Soft cards: each section a tinted rounded group with its icon; collapsed, a slim pill.
           sbModern sbGuides      Icon headers with guides: chevron, icon and title like the tree; rows beside a guide line.
           sbModern sbQuiet sbChips  Folded chips: open sections as Quiet; collapsed ones become chips above the tree.
         Only the look changes: every section opens, closes, adds and reorders the same way in each.
         ===================================================================================================================== -->
    <Style Selector="Border.sbDivider">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="16,8,16,8"/>
        <Setter Property="Background" Value="{DynamicResource BorderLight}"/>
    </Style>
    <Style Selector=".sbModern Border.sbDivider">
        <Setter Property="Height" Value="0"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector=".sbModern StackPanel#SidebarSections > StackPanel">
        <Setter Property="Margin" Value="0,2,0,2"/>
    </Style>
    <Style Selector=".sbModern Border.sbTreeGap">
        <Setter Property="Height" Value="6"/>
    </Style>
    <Style Selector="Border.sbTreeGap">
        <Setter Property="Height" Value="0"/>
    </Style>
    <Style Selector="TextBlock.sidebarCaps">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="0.9"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.sidebarCount">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="Opacity" Value="0.8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.sidebarBadge">
        <Setter Property="Background" Value="{DynamicResource PressedBg}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.sidebarBadge TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector=".sbModern Border.lensPill">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource SidebarChipBg}"/>
    </Style>
    <Style Selector=".sbModern Border.lensPill:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
    </Style>
    <Style Selector=".sbModern Border.lensPill.active">
        <Setter Property="Background" Value="{DynamicResource NavSelectedBg}"/>
    </Style>

    <!-- Quiet labels (and Chips' open sections) -->
    <Style Selector=".sbQuiet side|SidebarSection">
        <Setter Property="HeaderMargin" Value="14,6,8,0"/>
    </Style>
    <Style Selector=".sbQuiet side|SidebarSection:collapsed">
        <Setter Property="HeaderMargin" Value="14,0,8,0"/>
    </Style>
    <Style Selector=".sbQuiet side|SidebarSection /template/ TextBlock#PART_Title, .sbQuiet side|SidebarSection /template/ ic|SymbolIcon#PART_Chevron">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector=".sbQuiet side|SidebarSection /template/ TextBlock#PART_Caps, .sbQuiet side|SidebarSection /template/ ToggleButton#PART_TrailToggle">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector=".sbQuiet side|SidebarSection:collapsed:counted /template/ TextBlock#PART_Count">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector=".sbQuiet side|SidebarSection /template/ ToggleButton#PART_TrailToggle, .sbQuiet side|SidebarSection /template/ ContentPresenter#PART_Actions">
        <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector=".sbQuiet side|SidebarSection:collapsed /template/ ToggleButton#PART_TrailToggle">
        <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <Style Selector=".sbQuiet side|SidebarSection /template/ Grid#PART_Header:pointerover ToggleButton#PART_TrailToggle, .sbQuiet side|SidebarSection /template/ Grid#PART_Header:pointerover ContentPresenter#PART_Actions, .sbQuiet side|SidebarSection /template/ Grid#PART_Header:focus-within ContentPresenter#PART_Actions">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector=".sbQuiet side|SidebarSection /template/ Grid#PART_Header:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
    </Style>
    <Style Selector=".sbQuiet side|SidebarSection /template/ Grid#PART_Header">
        <Setter Property="MinHeight" Value="26"/>
    </Style>
    <Style Selector=".sbQuiet side|SidebarSection:collapsed /template/ Grid#PART_Header">
        <Setter Property="MinHeight" Value="24"/>
    </Style>

    <!-- Soft cards -->
    <Style Selector=".sbCards side|SidebarSection">
        <Setter Property="Margin" Value="8,3,8,3"/>
        <Setter Property="HeaderMargin" Value="6,2,4,2"/>
    </Style>
    <Style Selector=".sbCards side|SidebarSection /template/ Border#PART_Card">
        <Setter Property="Background" Value="{DynamicResource SidebarCardBg}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="0,0,0,6"/>
    </Style>
    <Style Selector=".sbCards side|SidebarSection:collapsed /template/ Border#PART_Card">
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector=".sbCards side|SidebarSection /template/ Grid#PART_Header">
        <Setter Property="MinHeight" Value="30"/>
    </Style>
    <Style Selector=".sbCards side|SidebarSection /template/ ic|SymbolIcon#PART_Icon">
        <Setter Property="IsVisible" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource SelectedAccent}"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
    </Style>
    <Style Selector=".sbCards side|SidebarSection /template/ TextBlock#PART_Title">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector=".sbCards side|SidebarSection /template/ ic|SymbolIcon#PART_Chevron">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector=".sbCards side|SidebarSection /template/ ToggleButton#PART_TrailToggle">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector=".sbCards side|SidebarSection:collapsed:counted /template/ Border#PART_Badge">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector=".sbCards side|SidebarSection:collapsed /template/ ContentPresenter#PART_Actions">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- Icon headers with guides -->
    <Style Selector=".sbGuides side|SidebarSection">
        <Setter Property="HeaderMargin" Value="6,2,8,0"/>
    </Style>
    <Style Selector=".sbGuides side|SidebarSection:collapsed">
        <Setter Property="HeaderMargin" Value="6,0,8,0"/>
    </Style>
    <Style Selector=".sbGuides side|SidebarSection /template/ Grid#PART_Header">
        <Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style Selector=".sbGuides side|SidebarSection /template/ ic|SymbolIcon#PART_LeadChevron, .sbGuides side|SidebarSection /template/ ic|SymbolIcon#PART_Icon, .sbGuides side|SidebarSection /template/ Border#PART_Guide">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector=".sbGuides side|SidebarSection /template/ ic|SymbolIcon#PART_Chevron">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector=".sbGuides side|SidebarSection /template/ TextBlock#PART_Title">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector=".sbGuides side|SidebarSection /template/ Border#PART_Guide">
        <Setter Property="Margin" Value="11,0,0,4"/>
    </Style>
    <Style Selector=".sbGuides side|SidebarSection /template/ ContentPresenter#PART_Content">
        <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>
    <Style Selector=".sbGuides side|SidebarSection:collapsed:counted /template/ TextBlock#PART_CountEnd">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector=".sbGuides side|SidebarSection:collapsed /template/ ContentPresenter#PART_Actions">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- Folded chips: a collapsed section leaves the list and shows as a chip in the row above the tree -->
    <Style Selector=".sbChips side|SidebarSection:collapsed">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="side|SidebarChipDock">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector=".sbChips side|SidebarChipDock.hasChips">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Button.sbChip">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bd" Background="{DynamicResource SidebarChipBg}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1"
                        CornerRadius="13" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.sbChip:pointerover /template/ Border#bd">
        <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
    </Style>
    <Style Selector="Button.sbChip:focus-visible /template/ Border#bd">
        <Setter Property="BorderBrush" Value="{DynamicResource SelectedAccent}"/>
    </Style>
</Styles>
